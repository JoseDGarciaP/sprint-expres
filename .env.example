# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Project Settings → API). Si los dejas vacíos, el juego funciona en "modo local".
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_o_publishable
# El PIN del panel (#admin) NO va aquí: se define en supabase/schema.sql (queda guardado en la base de datos).
# En modo local el PIN es scrum2026.
